{
  "name": "tier-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run movies:sync",
    "dev": "vite",
    "prebuild": "npm run movies:sync",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "books:validate": "node --import tsx scripts/books.ts validate",
    "books:sort": "node --import tsx scripts/books.ts sort",
    "movies:meta": "node --import tsx scripts/moviesMeta.ts",
    "movies:history": "node --import tsx scripts/moviesHistory.ts",
    "movies:enrich": "node --import tsx scripts/moviesEnrich.ts",
    "movies:sync": "npm run movies:meta && npm run movies:history",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.2",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "sass": "^1.103.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
